# Obsidian 未命名暫存：新建檔的預設名是 Untitled / Untitled 1 / Untitled 2 …
# 命名後會改名，自然脫離這個 pattern。
Untitled*

# === Local-only working folders ===
# Keep folder structure (.gitkeep + README.md) but ignore actual content.

sources/*
!sources/.gitkeep
!sources/README.md

drafts/*
!drafts/.gitkeep
!drafts/README.md

# Personal privacy patterns for scripts/check-privacy.mjs (never committed)
.privacy-patterns.local

# TypeScript 增量編譯快取（跑 tsc --noEmit 就會產生）
tsconfig.tsbuildinfo
